        "reviewAfter",
        "decisionOwnerRole",
        "nextAction"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "dataOwner": {
          "type": "string",
          "minLength": 1
        },
        "contactRole": {
          "type": "string",
          "minLength": 1
        },
