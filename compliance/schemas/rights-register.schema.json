{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zugfolge:compliance:rights-register:v1",
  "title": "Zugfolge rights register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "statusAsOf",
    "repositoryStatus",
    "statusRules",
    "ownership",
    "licensing",
    "brands",
    "assets",
    "sources",
    "services",
    "releaseCoverage",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "statusAsOf": {
      "$ref": "#/$defs/date"
    },
    "repositoryStatus": {
      "enum": [
        "PREPARATION",
        "LICENSED_REVIEW_PENDING",
        "ACTIVE",
        "SUSPENDED"
      ]
    },
    "statusRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionEligibleSourceStatuses",
        "resolvedSourceStatuses",
        "blockingSourceStatuses",
        "requiredSnapshotFields",
        "privateEvidencePolicy",
        "approvalExpiryPolicy"
      ],
      "properties": {
        "productionEligibleSourceStatuses": {
          "const": ["APPROVED", "APPROVED_WITH_CONDITIONS"]
        },
        "resolvedSourceStatuses": {
          "const": [
            "APPROVED",
            "APPROVED_WITH_CONDITIONS",
            "SUBSTITUTED",
            "EXCLUDED",
            "REJECTED"
          ]
        },
        "blockingSourceStatuses": {
          "const": [
            "CANDIDATE",
            "HUMAN_REVIEW_REQUIRED",
            "CONTRACT_REQUIRED",
            "EXPIRED"
          ]
        },
        "requiredSnapshotFields": {
          "const": [
            "sourceId",
            "sourceLicenseRevision",
            "retrievedAt",
            "sourceValidFrom",
            "sourceValidTo",
            "schemaVersion",
            "checksumSha256",
            "byteSize",
            "rawObjectUri",
            "transformationVersion",
            "parentSnapshotIds",
            "fieldProvenance",
            "confidence",
            "qualityClass",
            "approvalStatus"
          ]
        },
        "privateEvidencePolicy": {
          "const": "REFERENCE_AND_DIGEST_ONLY"
        },
        "approvalExpiryPolicy": {
          "const": "EVALUATE_AT_CI_RUN_DATE"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rightsHolderRole",
        "externalContributions",
        "selectedContributionModel",
        "contributionModelStatus",
        "claActivationStatus",
        "aiAssistedWorkReview",
        "evidenceRefs",
        "nextAction"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/decisionStatus"
        },
        "rightsHolderRole": {
          "type": "string",
          "minLength": 1
        },
        "externalContributions": {
          "enum": ["CLOSED", "PERMITTED_DCO", "PERMITTED_CLA"]
        },
        "selectedContributionModel": {
          "enum": ["NONE", "DCO", "CLA"]
        },
        "contributionModelStatus": {
          "enum": [
            "UNDECIDED",
            "OWNER_SELECTED_COUNSEL_PENDING",
            "COUNSEL_REVIEWED_NOT_ACTIVE",
            "ACTIVE",
            "REJECTED"
          ]
        },
        "claActivationStatus": {
          "enum": ["NOT_APPLICABLE", "NOT_ACTIVE", "ACTIVE", "SUSPENDED"]
        },
        "aiAssistedWorkReview": {
          "enum": ["PENDING", "COMPLETE"]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ownerDecision",
        "publicationStatus",
        "rootLicenseModel",
        "firstLicensePublication",
        "components",
        "openReviewQuestions",
        "nextAction"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/licenseDecisionStatus"
        },
        "ownerDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "deciderRole",
            "decidedAt",
            "evidenceRefs"
          ],
          "properties": {
            "status": {
              "enum": ["NOT_RECORDED", "RECORDED"]
            },
            "deciderRole": {
              "type": "string",
              "minLength": 1
            },
            "decidedAt": {
              "$ref": "#/$defs/dateTime"
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            }
          }
        },
        "publicationStatus": {
          "enum": ["NOT_PUBLISHED", "ACTIVE", "SUSPENDED_PROSPECTIVELY"]
        },
        "rootLicenseModel": {
          "enum": ["UNLICENSED", "SINGLE_LICENSE", "LICENSE_MOSAIC"]
        },
        "firstLicensePublication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "state",
            "grantCommit",
            "attestedAt",
            "evidenceRefs"
          ],
          "properties": {
            "protocol": {
              "const": "TWO_COMMIT_PARENT_ATTESTATION_V1"
            },
            "state": {
              "enum": ["PENDING_ATTESTATION", "ATTESTED"]
            },
            "grantCommit": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{40}$"
            },
            "attestedAt": {
              "oneOf": [
                {
                  "$ref": "#/$defs/dateTime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "PENDING_ATTESTATION"
                  }
                }
              },
              "then": {
                "properties": {
                  "grantCommit": {
                    "type": "null"
                  },
                  "attestedAt": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "grantCommit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "attestedAt": {
                    "$ref": "#/$defs/dateTime"
                  }
                }
              }
            }
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scope",
              "selectedTreatment",
              "publicationStatus",
              "status",
              "humanGate"
            ],
            "properties": {
              "id": {
                "enum": [
                  "game-code",
                  "public-contracts-sdks",
                  "original-documentation",
                  "synthetic-fixtures",
                  "osm-derived-database",
                  "brand-premium-media"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "selectedTreatment": {
                "type": "string",
                "minLength": 1
              },
              "publicationStatus": {
                "enum": [
                  "ACTIVE",
                  "EXCLUDED_FROM_LICENSE_GRANT",
                  "POLICY_ONLY_NO_ARTIFACT",
                  "RIGHTS_RESERVATION_ACTIVE"
                ]
              },
              "status": {
                "$ref": "#/$defs/decisionStatus"
              },
              "humanGate": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "game-code"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "selectedTreatment": {
                      "const": "AGPL-3.0-or-later"
                    },
                    "publicationStatus": {
                      "const": "ACTIVE"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "public-contracts-sdks"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "selectedTreatment": {
                      "const": "Apache-2.0"
                    },
                    "publicationStatus": {
                      "const": "ACTIVE"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "original-documentation"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "selectedTreatment": {
                      "const": "CC-BY-4.0"
                    },
                    "publicationStatus": {
                      "const": "ACTIVE"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "synthetic-fixtures"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "selectedTreatment": {
                      "const": "LicenseRef-Zugfolge-Provenance-Pending"
                    },
                    "publicationStatus": {
                      "const": "EXCLUDED_FROM_LICENSE_GRANT"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "osm-derived-database"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "selectedTreatment": {
                      "const": "ODbL-1.0"
                    },
                    "publicationStatus": {
                      "const": "POLICY_ONLY_NO_ARTIFACT"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "brand-premium-media"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "publicationStatus": {
                      "const": "RIGHTS_RESERVATION_ACTIVE"
                    }
                  }
                }
              }
            ]
          }
        },
        "openReviewQuestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/brand"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "releaseCoverage": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/releaseCoverage"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ownerRole",
        "reviewedAt",
        "reviewAfter",
        "currentDemoData",
        "externalHostingData",
        "productionDataInventory",
        "legalBasisInventory",
        "processorInventory",
        "retentionInventory",
        "dataSubjectRightsRunbook",
        "evidenceRefs",
        "nextAction"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/decisionStatus"
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "reviewAfter": {
          "$ref": "#/$defs/date"
        },
        "currentDemoData": {
          "$ref": "#/$defs/stringArray"
        },
        "externalHostingData": {
          "$ref": "#/$defs/stringArray"
        },
        "productionDataInventory": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"]
        },
        "legalBasisInventory": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"]
        },
        "processorInventory": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"]
        },
        "retentionInventory": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"]
        },
        "dataSubjectRightsRunbook": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "repositoryStatus": {
            "const": "LICENSED_REVIEW_PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "ownership": {
            "type": "object",
            "properties": {
              "status": {
                "const": "HUMAN_REVIEW_REQUIRED"
              }
            }
          },
          "licensing": {
            "type": "object",
            "properties": {
              "status": {
                "const": "OWNER_DECIDED_COUNSEL_PENDING"
              },
              "publicationStatus": {
                "const": "ACTIVE"
              },
              "rootLicenseModel": {
                "const": "LICENSE_MOSAIC"
              },
              "ownerDecision": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "RECORDED"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ownership": {
            "type": "object",
            "required": [
              "selectedContributionModel",
              "externalContributions"
            ],
            "properties": {
              "selectedContributionModel": {
                "const": "CLA"
              },
              "externalContributions": {
                "const": "CLOSED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ownership": {
            "type": "object",
            "properties": {
              "claActivationStatus": {
                "enum": ["NOT_ACTIVE", "SUSPENDED"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ownership": {
            "type": "object",
            "required": ["externalContributions"],
            "properties": {
              "externalContributions": {
                "const": "PERMITTED_CLA"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ownership": {
            "type": "object",
            "properties": {
              "selectedContributionModel": {
                "const": "CLA"
              },
              "contributionModelStatus": {
                "const": "ACTIVE"
              },
              "claActivationStatus": {
                "const": "ACTIVE"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "dateOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentRole",
        "digestSha256",
        "decisionDate",
        "reviewerRole"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "documentRole": {
          "enum": [
            "OWNERSHIP",
            "LICENSE_DECISION",
            "SOURCE_TERMS",
            "SOURCE_APPROVAL",
            "ASSET_PROVENANCE",
            "BRAND_SEARCH",
            "SERVICE_REVIEW",
            "PRIVACY_REVIEW",
            "OTHER"
          ]
        },
        "digestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "decisionDate": {
          "$ref": "#/$defs/date"
        },
        "reviewerRole": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decisionStatus": {
      "enum": ["HUMAN_REVIEW_REQUIRED", "APPROVED", "REJECTED"]
    },
    "licenseDecisionStatus": {
      "enum": [
        "HUMAN_REVIEW_REQUIRED",
        "OWNER_DECIDED_COUNSEL_PENDING",
        "COUNSEL_REVIEWED",
        "REJECTED"
      ]
    },
    "sourceStatus": {
      "enum": [
        "CANDIDATE",
        "HUMAN_REVIEW_REQUIRED",
        "CONTRACT_REQUIRED",
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "SUBSTITUTED",
        "EXCLUDED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "permission": {
      "enum": [
        "ALLOWED",
        "CONDITIONAL",
        "PROHIBITED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "resolvedPermission": {
      "enum": [
        "ALLOWED",
        "CONDITIONAL",
        "PROHIBITED",
        "NOT_APPLICABLE"
      ]
    },
    "finalPermission": {
      "enum": [
        "ALLOWED",
        "PROHIBITED",
        "NOT_APPLICABLE"
      ]
    },
    "nonApprovedPermission": {
      "enum": [
        "CONDITIONAL",
        "PROHIBITED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "resolvedPermissions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/resolvedPermission"
      }
    },
    "finalPermissions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/finalPermission"
      }
    },
    "nonApprovedPermissions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nonApprovedPermission"
      }
    },
    "excludedPermissions": {
      "type": "object",
      "additionalProperties": {
        "enum": ["PROHIBITED", "NOT_APPLICABLE"]
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "displayName",
        "status",
        "ownerRole",
        "intendedTerritories",
        "intendedClasses",
        "searchScope",
        "searchStatus",
        "searchOutcome",
        "searchedAt",
        "reviewerRole",
        "reviewedAt",
        "reviewAfter",
        "fallback",
        "renewalOwnerRole",
        "officialSearchUrls",
        "evidenceRefs",
        "nextAction"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["WORD_MARK", "DEVICE_MARK", "CLAIM", "DOMAIN"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["CLEARANCE_REQUIRED", "ACQUISITION_REQUIRED", "CLEARED", "REJECTED"]
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1
        },
        "intendedTerritories": {
          "$ref": "#/$defs/stringArray"
        },
        "intendedClasses": {
          "$ref": "#/$defs/stringArray"
        },
        "searchScope": {
          "type": "string",
          "minLength": 1
        },
        "searchStatus": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"]
        },
        "searchOutcome": {
          "enum": [
            "NOT_REVIEWED",
            "NO_BLOCKER_FOUND",
            "BLOCKER_FOUND",
            "INCONCLUSIVE"
          ]
        },
        "searchedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "reviewerRole": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "reviewAfter": {
          "$ref": "#/$defs/date"
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "renewalOwnerRole": {
          "type": "string",
          "minLength": 1
        },
        "officialSearchUrls": {
          "$ref": "#/$defs/uriArray"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "CLEARED"
              }
            }
          },
          "then": {
            "properties": {
              "searchStatus": {
                "const": "COMPLETE"
              },
              "searchOutcome": {
                "const": "NO_BLOCKER_FOUND"
              },
              "searchedAt": {
                "$ref": "#/$defs/date"
              },
              "reviewedAt": {
                "$ref": "#/$defs/date"
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "provenanceStatus",
        "ownerRole",
        "origin",
        "aiAssistance",
        "licenseDecision",
        "evidenceRefs",
        "approvedUses",
        "reviewerRole",
        "reviewDecision",
        "reviewedAt",
        "reviewAfter",
        "withdrawal",
        "nextAction"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "provenanceStatus": {
          "enum": ["ORIGIN_REVIEW_REQUIRED", "APPROVED", "REJECTED"]
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "aiAssistance": {
          "enum": ["NONE_DECLARED", "AI_ASSISTED", "UNKNOWN"]
        },
        "licenseDecision": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "approvedUses": {
          "$ref": "#/$defs/stringArray"
        },
        "reviewerRole": {
          "type": "string",
          "minLength": 1
        },
        "reviewDecision": {
          "enum": ["NOT_REVIEWED", "APPROVED", "REJECTED"]
        },
        "reviewedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "reviewAfter": {
          "$ref": "#/$defs/date"
        },
        "withdrawal": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenanceStatus": {
                "const": "APPROVED"
              }
            }
          },
          "then": {
            "properties": {
              "reviewDecision": {
                "const": "APPROVED"
              },
              "reviewedAt": {
                "$ref": "#/$defs/date"
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1
              },
              "approvedUses": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "source": {
