          "$ref": "#/$defs/stringArray"
        },
        "geographicScope": {
          "type": "string",
          "minLength": 1
        },
        "sourceSchemaOrProfileVersion": {
          "type": "string",
          "minLength": 1
        },
        "freshnessPolicy": {
          "type": "string",
          "minLength": 1
        },
        "sourceValidFrom": {
          "$ref": "#/$defs/dateOrNull"
        },
        "sourceValidTo": {
          "$ref": "#/$defs/dateOrNull"
        },
        "contractExpiresAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "forbiddenUses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumerMilestones": {
          "$ref": "#/$defs/stringArray"
        },
        "requiredByRelease": {
          "type": ["string", "null"],
          "pattern": "^RG-[0-7]$"
        },
        "status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "intendedUse": {
          "type": "string",
          "minLength": 1
        },
        "currentDecision": {
          "type": "string",
          "minLength": 1
        },
        "officialUrls": {
          "$ref": "#/$defs/uriArray"
        },
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "licenseOrPermission",
            "termsUrl",
            "termsVersion",
            "retrievedAt",
            "archivedEvidenceRef",
            "archivedEvidenceDigestSha256"
          ],
          "properties": {
            "licenseOrPermission": {
              "type": "string",
              "minLength": 1
            },
            "termsUrl": {
              "type": ["string", "null"],
              "format": "uri"
            },
            "termsVersion": {
              "type": "string",
              "minLength": 1
            },
            "retrievedAt": {
              "$ref": "#/$defs/date"
            },
            "archivedEvidenceRef": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "archivedEvidenceDigestSha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deliveryMode",
            "endpointOrLocator",
            "authentication",
            "rateLimit",
            "updateCadence",
            "hotPath"
          ],
          "properties": {
            "deliveryMode": {
              "type": "string",
              "minLength": 1
            },
            "endpointOrLocator": {
              "type": "string",
              "minLength": 1
            },
            "authentication": {
              "type": "string",
              "minLength": 1
            },
            "rateLimit": {
              "type": "string",
              "minLength": 1
            },
            "updateCadence": {
              "type": "string",
              "minLength": 1
            },
            "hotPath": {
              "const": false
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commercialUse",
            "automatedRetrieval",
            "storage",
            "transformation",
            "combination",
            "display",
            "redistribution",
            "archival",
            "replay",
            "fixtures"
          ],
          "properties": {
            "commercialUse": {
              "$ref": "#/$defs/permission"
            },
            "automatedRetrieval": {
              "$ref": "#/$defs/permission"
            },
            "storage": {
              "$ref": "#/$defs/permission"
            },
            "transformation": {
              "$ref": "#/$defs/permission"
            },
            "combination": {
              "$ref": "#/$defs/permission"
            },
            "display": {
              "$ref": "#/$defs/permission"
            },
            "redistribution": {
              "$ref": "#/$defs/permission"
            },
            "archival": {
              "$ref": "#/$defs/permission"
            },
            "replay": {
              "$ref": "#/$defs/permission"
            },
            "fixtures": {
              "$ref": "#/$defs/permission"
            }
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "text", "placement", "licenseUrl"],
          "properties": {
            "required": {
              "type": ["boolean", "null"]
            },
            "text": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "placement": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "licenseUrl": {
              "type": ["string", "null"],
              "format": "uri"
            }
          }
        },
        "databaseClassification": {
          "enum": [
            "NOT_APPLICABLE",
            "ORIGINAL",
            "DERIVATIVE_REVIEW_REQUIRED",
            "COLLECTIVE_REVIEW_REQUIRED",
            "UNKNOWN"
          ]
        },
        "privacyClass": {
          "enum": ["PUBLIC_NON_PERSONAL", "PERSONAL_DATA_REVIEW_REQUIRED", "UNKNOWN"]
        },
        "failureBehavior": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        },
        "deletion": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "substituteSourceId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "withdrawal": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "reviewedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "reviewAfter": {
          "$ref": "#/$defs/date"
        },
        "decisionOwnerRole": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUBSTITUTED"
              }
            }
          },
          "then": {
            "properties": {
              "substituteSourceId": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["APPROVED", "APPROVED_WITH_CONDITIONS"]
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "$ref": "#/$defs/resolvedPermissions"
              },
              "privacyClass": {
                "enum": ["PUBLIC_NON_PERSONAL", "PERSONAL_DATA_REVIEW_REQUIRED"]
              },
              "reviewedAt": {
                "$ref": "#/$defs/date"
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1
              },
              "terms": {
                "type": "object",
                "properties": {
                  "archivedEvidenceRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "archivedEvidenceDigestSha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "$ref": "#/$defs/finalPermissions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "CANDIDATE",
                  "HUMAN_REVIEW_REQUIRED",
                  "CONTRACT_REQUIRED",
                  "SUBSTITUTED",
                  "REJECTED",
                  "EXPIRED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "$ref": "#/$defs/nonApprovedPermissions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXCLUDED"
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "$ref": "#/$defs/excludedPermissions"
              }
            }
          }
        }
      ]
    },
