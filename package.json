{
  "name": "zugfolge",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "exports": {
    "./domain": "./packages/domain/index.mjs"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "coverage:node": "vinext build && node tools/run-node-coverage.mjs",
    "start": "vinext start",
    "test": "vinext build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/domain.test.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .gradle-build --ignore-pattern .venv --ignore-pattern outputs --ignore-pattern work",
    "verify:spec": "node tools/spec-lint.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@asyncapi/specs": "6.11.1",
    "@cloudflare/vite-plugin": "1.50.0",
    "@eslint/js": "9.39.4",
    "@redocly/cli": "2.42.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0",
    "yaml": "2.9.0"
  },
  "type": "module"
}
